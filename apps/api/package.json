{
  "name": "@slate/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node --import tsx src/cli.ts migrate",
    "bootstrap": "node --import tsx src/cli.ts bootstrap",
    "seed:dev": "node --import tsx src/cli.ts seed-development",
    "seed:demo": "node --import tsx src/cli.ts seed-demo",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@slate/contracts": "0.1.0",
    "@electric-sql/pglite": "^0.3.14",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.1.0",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0"
  }
}
