{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://otp-slate-admin.pages.dev",
          "https://otp-slate-student.pages.dev",
          "http://admin.localhost:5174",
          "http://student.localhost:5173",
          "http://localhost:5174",
          "http://localhost:5173",
          "http://127.0.0.1:5174",
          "http://127.0.0.1:5173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Range"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range"],
      "maxAgeSeconds": 3600
    }
  ]
}
