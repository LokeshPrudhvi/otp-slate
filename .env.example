# Local development uses an embedded PostgreSQL engine. Never use pglite in production.
NODE_ENV=development
DATABASE_URL=pglite://.local/slate
# Generate a random value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://student.localhost:5173,http://admin.localhost:5174,http://organization.localhost:5175
API_PORT=3000
# Production: DATABASE_URL must use a restricted Neon runtime role.
# MIGRATION_DATABASE_URL is used only by the migrate/bootstrap commands.
MIGRATION_DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
EXECUTION_PROVIDER=unconfigured
